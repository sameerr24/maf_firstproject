{
  "_comment": "Curated product-selection rules. Edit this file (not the scripts) to change which SKUs are selected. See README.md -> 'Modifying product selections'.",
  "source_csv": "BigBasket.csv",
  "max_products": 20,
  "allow_duplicate_product_types": false,
  "global_exclusions": {
    "_comment": "Rows matching these are never auto-selected (multi-product combos / bundles).",
    "pack_size_patterns": [
      "^combo$"
    ],
    "name_patterns": [
      "\\bcombo\\b",
      "\\s\\+\\s",
      "\\d\\s?(g|kg|ml)\\s?\\+"
    ]
  },
  "brand_aliases": {
    "_comment": "Map raw Brand values to a cleaned brand name. Keys are matched case-insensitively after whitespace cleanup.",
    "Head & shoulders": "Head & Shoulders",
    "Closeup": "Close Up",
    "MAGGI": "Maggi",
    "Red Label": "Brooke Bond Red Label"
  },
  "display_name_overrides": {
    "_comment": "Optional: SKU id -> clean display name. Keyed by SKU so a stale name is never applied to a different product. The original name is always kept in original_product_name.",
    "40072320": "Farm Eggs - Table Tray, Medium",
    "40003162": "Farm Fresh Curd/Dahi",
    "10000415": "Sona Masoori Raw Rice",
    "126903": "Atta - Whole Wheat",
    "274145": "Sun Lite Sunflower Refined Oil",
    "263642": "Tea Gold",
    "292149": "Sunrise Instant Coffee - Chicory Mix",
    "266162": "2-Minute Instant Masala Noodles",
    "20005547": "Strong Teeth Toothpaste",
    "100008548": "Original Bathing Bar Soap",
    "40226539": "Dishwashing Liquid - Pomegranate"
  },
