  "segments": {
    "_comment": "count: customers in this segment (must sum to n_customers). interval_multiplier: scales each product's interval (quantity scales with it so consumption stays plausible). min_interval_days: floor on gaps. extra_interval_cv: added randomness. skip_probability: chance a purchase occasion is missed (gap doubles). order_window_days: purchases within this many days are merged into one order. weekly_snap: snap orders to the customer's preferred weekday.",
    "regular":             {"count": 20, "products": [9, 15], "interval_multiplier": 1.0, "min_interval_days": 1, "extra_interval_cv": 0.05, "skip_probability": 0.03, "order_window_days": 1, "weekly_snap": false},
    "weekly":              {"count": 18, "products": [8, 14], "interval_multiplier": 1.0, "min_interval_days": 7, "extra_interval_cv": 0.05, "skip_probability": 0.05, "order_window_days": 0, "weekly_snap": true},
    "bulk":                {"count": 12, "products": [6, 12], "interval_multiplier": 2.5, "min_interval_days": 6, "extra_interval_cv": 0.10, "skip_probability": 0.05, "order_window_days": 4, "weekly_snap": false},
    "irregular":           {"count": 15, "products": [4, 11], "interval_multiplier": 1.6, "min_interval_days": 2, "extra_interval_cv": 0.45, "skip_probability": 0.30, "order_window_days": 1, "weekly_snap": false},
    "new":                 {"count": 12, "products": [3, 9],  "interval_multiplier": 1.0, "min_interval_days": 1, "extra_interval_cv": 0.10, "skip_probability": 0.05, "order_window_days": 1, "weekly_snap": false,
                            "signup_days_before_end": [7, 45]},
    "lapsed":              {"count": 10, "products": [6, 12], "interval_multiplier": 1.0, "min_interval_days": 1, "extra_interval_cv": 0.10, "skip_probability": 0.05, "order_window_days": 1, "weekly_snap": false,
