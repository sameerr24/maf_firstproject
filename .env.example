# Copy this file to .env and fill in the values. .env is git-ignored: never commit it.
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
# URL-encode special characters in passwords (@ -> %40, : -> %3A, / -> %2F, # -> %23).

# --- Shared team database (Supabase) -------------------------------------------
# Supabase dashboard -> your project -> "Connect" -> "Session pooler" (works on IPv4 networks).
# Replace "postgresql://" with "postgresql+psycopg://" and append ?sslmode=require.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Alternative: a local PostgreSQL for offline work
# DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/recommendation_db

# --- Tests ----------------------------------------------------------------------
# A LOCAL database used only by pytest (name must contain "test"). Tests create and drop
# temporary schemas there and refuse to run against DATABASE_URL or a Supabase "postgres" DB.
# Leave unset to skip the PostgreSQL integration tests.
TEST_DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/recommendation_db_test

# --- Flask app ------------------------------------------------------------------
# Long random string, e.g. python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me

# --- Recommendation API (FastAPI) -------------------------------------------------
# Uses DATABASE_URL above. All optional; defaults shown.
# REC_API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# REC_API_LOG_LEVEL=INFO
# REC_API_PORT=8000
# REC_API_HOST=127.0.0.1
# REC_API_DOCS=true
# REC_API_SCORING_CONFIG=recommendation_engine/config/scoring_config.json

# --- Customer auth (shared by the FastAPI and Flask apps) ----------------------------
# REQUIRED. Signs JWT access tokens; keep separate from all MSG91 credentials.
# At least 32 characters. Generate with:
#   .venv/bin/python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=change-me-to-a-long-random-string
# Access tokens default to 15 minutes; refresh tokens default to 30 days.
# AUTH_ACCESS_TOKEN_TTL_SECONDS=900
# AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# AUTH_JWT_ISSUER=smart-reorder
# AUTH_JWT_AUDIENCE=smart-reorder-client
# Secure HttpOnly refresh cookie (set false only for local HTTP development if required).
# AUTH_COOKIE_SECURE=true

# --- MSG91 OTP Widget ---------------------------------------------------------------
# Widget Token Auth is used by MSG91's hosted Web Widget and is intentionally returned
# from /api/v1/auth/widget-config. Restrict its allowed domains in MSG91. The Authkey
# below is server-only and verifies the Widget access token independently.
MSG91_WIDGET_ID=
MSG91_TOKEN_AUTH=
MSG91_AUTHKEY=

# --- Subscriptions API (Flask) -------------------------------------------------------
# `python run.py` listens on FLASK_PORT (5000 is taken by macOS's AirPlay Receiver).
# FLASK_PORT=5001
# Browser origins allowed to call Flask (the React dev server).
# FLASK_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Subscription scheduler -------------------------------------------------------
# Run the reminder / auto-skip jobs in the background inside Flask (1 = on).
SCHEDULER_ENABLED=0
SCHEDULER_INTERVAL_MINUTES=5
# Dev/demo endpoints such as POST /api/dev/run-scheduler?now=<iso> (never enable in production).
DEV_ENDPOINTS=0

# --- Admin panel (python run_admin.py; admin-frontend on :5174) ---------------------------
# Local-only, no login by design: binds to 127.0.0.1 and only answers Host localhost/127.0.0.1.
# ADMIN_PORT=5002
# ADMIN_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# --- Chat notifications (demo channel: Telegram bot, stand-in for WhatsApp) ---------
# From @BotFather (/newbot). When set, reminders are sent through the bot; run the bot with
#   flask --app run telegram-poll
TELEGRAM_BOT_TOKEN=
